{
  "name": "carrebola-controlhorari",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:dev": "node --require ./scripts/local-browser.cjs ./node_modules/wrangler/bin/wrangler.js dev --config cloudflare/wrangler.jsonc",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.jsonc",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote --config cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "push:setup": "node scripts/setup-push.cjs",
    "test:push:worker": "node scripts/push-worker-check.cjs",
    "test:today": "node scripts/check-auto-today.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.3",
    "playwright": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
